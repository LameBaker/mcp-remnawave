{
  "name": "remnawave-mcp",
  "version": "1.3.0",
  "description": "MCP server for Remnawave proxy management panel",
  "type": "module",
  "bin": {
    "remnawave-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "esbuild tests/regression.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/regression.mjs --external:@modelcontextprotocol/sdk --log-level=error && node node_modules/.cache/regression.mjs",
    "check:bodies": "npm run check:contract",
    "check:contract": "esbuild tests/contract-coverage.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/contract-coverage.mjs --log-level=error && node node_modules/.cache/contract-coverage.mjs",
    "check:requests": "esbuild tests/request-validation.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/request-validation.mjs --log-level=error && node node_modules/.cache/request-validation.mjs",
    "check": "npm run typecheck && npm test && npm run check:contract && npm run check:requests && npm run docs:tools -- --check",
    "docs:tools": "esbuild tests/readme-tools.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/readme-tools.mjs --external:@modelcontextprotocol/sdk --log-level=error && node node_modules/.cache/readme-tools.mjs"
  },
  "keywords": [
    "mcp",
    "remnawave",
    "vpn",
    "proxy",
    "xray"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@remnawave/backend-contract": "^3.4.15",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
